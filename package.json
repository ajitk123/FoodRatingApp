{
  "name": "reactrealmjstemplateapp",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:web": "expo export:web",
    "test": "jest",
    "test:coverage": "jest --coverage --watchAll=false",
    "lint": "eslint app/ --ext .js,.jsx --max-warnings 0",
    "lint:fix": "eslint app/ --ext .js,.jsx --fix",
    "format:check": "prettier --check 'app/**/*.{js,jsx,json}'",
    "format": "prettier --write 'app/**/*.{js,jsx,json}'"
  },
  "dependencies": {
    "@react-navigation/native": "^6.0.12",
    "@react-navigation/native-stack": "^6.8.0",
    "@react-navigation/stack": "^6.3.2",
    "@realm/react": "^0.3.1",
    "expo": "^44.0.6",
    "expo-dev-client": "~0.8.4",
    "expo-splash-screen": "~0.14.2",
    "expo-status-bar": "~1.2.0",
    "expo-updates": "~0.11.6",
    "react": "17.0.1",
    "react-dom": "17.0.1",
    "react-native": "0.64.3",
    "react-native-get-random-values": "~1.8.0",
    "react-native-maps": "0.29.4",
    "react-native-safe-area-context": "3.3.2",
    "react-native-screens": "~3.10.1",
    "react-native-star-rating": "^1.1.0",
    "react-native-vector-icons": "^9.2.0",
    "react-native-web": "0.17.1",
    "realm": "^10.19.0"
  },
  "devDependencies": {
    "@babel/core": "^7.12.9",
    "@babel/eslint-parser": "^7.23.10",
    "@testing-library/react-native": "^12.4.3",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-native": "^4.1.0",
    "jest": "^29.7.0",
    "prettier": "^3.2.5",
    "react-test-renderer": "17.0.1"
  },
  "private": true
}
